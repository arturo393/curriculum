#!/usr/bin/env python3
"""
🚀 CV Simple - Script de Acceso Rápido
Wrapper para ejecutar cv-simple desde cualquier lugar
"""

import os
import sys
import subprocess
from pathlib import Path

def main():
    print("🚀 CV Simple - Generador Profesional Minimalista")
    print("=" * 55)
    print()
    
    # Encontrar directorio cv-simple
    repo_root = Path(__file__).parent
    cv_simple_dir = repo_root / "cv-simple"
    
    if not cv_simple_dir.exists():
        print("❌ Error: Directorio cv-simple/ no encontrado")
        print(f"   Buscado en: {cv_simple_dir}")
        sys.exit(1)
    
    generator_path = cv_simple_dir / "generate-cv.py"
    
    if not generator_path.exists():
        print("❌ Error: generate-cv.py no encontrado")
        print(f"   Buscado en: {generator_path}")
        sys.exit(1)
    
    # Cambiar al directorio cv-simple
    os.chdir(cv_simple_dir)
    
    print(f"📁 Directorio de trabajo: {cv_simple_dir}")
    print("⚡ Ejecutando generador CV...")
    print()
    
    # Ejecutar el generador
    try:
        subprocess.run([sys.executable, "generate-cv.py"], check=True)
    except subprocess.CalledProcessError as e:
        print(f"❌ Error ejecutando generador: {e}")
        sys.exit(1)
    except KeyboardInterrupt:
        print("\n🔄 Proceso cancelado por el usuario")
        sys.exit(0)

if __name__ == "__main__":
    main()