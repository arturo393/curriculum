#!/bin/bash

# 🚀 CV Simple - Script de Conveniencia
# Ejecuta el generador CV simple desde cualquier ubicación

echo "🚀 CV Simple - Generador Profesional Minimalista"
echo "================================================"
echo ""

# Verificar que estamos en el directorio correcto
if [ ! -d "cv-simple" ]; then
    echo "❌ Error: Debes ejecutar este script desde el directorio raíz del repositorio"
    echo "💡 Uso: ./generate-cv desde /curriculum/"
    exit 1
fi

# Cambiar al directorio cv-simple
cd cv-simple

# Verificar que existe el generador
if [ ! -f "generate-cv.py" ]; then
    echo "❌ Error: No se encuentra generate-cv.py en cv-simple/"
    exit 1
fi

# Ejecutar generador
echo "🎯 Ejecutando generador CV simple..."
echo ""
python3 generate-cv.py

# Mostrar resultados si se generó algo
if [ -d "output" ] && [ "$(ls -A output)" ]; then
    echo ""
    echo "📁 Archivos generados en cv-simple/output/:"
    ls -la output/
    echo ""
    echo "💡 Próximos pasos:"
    echo "   1. Abrir archivo .md generado"
    echo "   2. Copiar contenido a Google Docs"
    echo "   3. Aplicar formato profesional"
    echo "   4. Exportar como PDF"
fi

echo ""
echo "✅ ¡Proceso completado!"